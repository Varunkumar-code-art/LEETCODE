class solution 
{
    public int maxSubArray(int[] arr) 
    {
        int max_sum=Integer.MIN_VALUE;
        for(int i=0;i<arr.length;i++)
        {
            for(int j=i;j<arr.length;j++)
            {
                int sum=0;
                for(int k=i;k<=j;k++)
                {
                    sum=sum+arr[k];
                }
                if(sum>max_sum)
                {
                    max_sum=sum;
                }
            }
        }
        return max_sum;
    }
}
